# Data (too large for git; re-downloadable via scripts/download_era5.py)
data/raw/**
data/interim/**
data/processed/**
!data/raw/era5/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Labels are small and hand-curated -- keep them in git
!data/labels/**

# Figures are regenerated by scripts; keep the folder, not the files
figures/*.png
figures/*.pdf
!figures/.gitkeep

# Results (large model artifacts); keep small summary tables if you want
results/*.pkl
results/*.joblib

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# OS
.DS_Store

# Secrets
.cdsapirc
*.env
